{
  "mcpServers": {
    "apify": {
      "command": "npx",
      "args": [
        "-y",
        "@apify/actors-mcp-server@0.19.0",
        "--tools",
        "actors,runs,storage,apify/instagram-reel-scraper,apify/instagram-hashtag-scraper,apify/instagram-scraper"
      ],
      "env": {
        "APIFY_TOKEN": "${APIFY_TOKEN}"
      }
    }
  }
}
